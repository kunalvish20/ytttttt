# =========================================================
# PAYU - REQUIRED
# PAYU_ENV=test uses PayU test endpoints.
# PAYU_ENV=live uses real production endpoints and real money.
# =========================================================
PAYU_KEY=your-payu-key
PAYU_SALT=your-payu-salt
PAYU_ENV=test

# =========================================================
# COURSE SECURITY - REQUIRED
# Generate a fresh 32+ byte random secret, e.g.:
# openssl rand -base64 32
# Do NOT reuse PAYU_SALT and do NOT expose this client-side.
# =========================================================
COURSE_ACCESS_SECRET=TfjyUprtxui0H9qj58RIYUBVmwImOVPF
COURSE_PRICE_INR=1

# =========================================================
# SITE
